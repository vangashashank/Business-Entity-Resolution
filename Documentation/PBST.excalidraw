      "link": null,
      "locked": false,
      "text": "- name: levenshtein_ratio, jaccard (token set), tfidf_cosine,\nfirst_token_match, length_ratio\n\n- address: levenshtein_ratio, jaccard, tfidf_cosine, numeric_token_match\n  (PIN/building numbers), component_count_diff\n\n- country_match (binary), abbreviation_normalized_match",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- name: levenshtein_ratio, jaccard (token set), tfidf_cosine, first_token_match, length_ratio\n\n- address: levenshtein_ratio, jaccard, tfidf_cosine, numeric_token_match\n  (PIN/building numbers), component_count_diff\n\n- country_match (binary), abbreviation_normalized_match",
      "autoResize": false,
      "lineHeight": 1.25
    },
